<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- production: what TestFlight and the App Store require. The server sends to the production
	     APNs host and retries the sandbox on BadDeviceToken, so a local debug build still works. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
